{
    "fim": {
        "monitor_paths": ["./", "/tmp"],
        "check_interval": 4
    },
    "yara": {
        "rules_files": {
            "sample": "sample.yar"
        }
    },
    "logging": {
        "level": "INFO",
        "file": "firewall.log"
    },
    "process_monitor": {
        "check_interval": 5,
        "network_threshold": 1000000
    },
    "pe_analysis": {
        "entropy_threshold": 6.5,
        "enable_auto_analysis": true
    }
}
